      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='real' name='[Calculation_2205114956021760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_2205114956406785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_2205114956570626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Amount])' />
      </column>
      <column caption='Return Flag' datatype='string' name='[Calculation_2205114956705795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss&quot; ELSE &quot;Profit&quot; END' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_2205114956898308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount]) / COUNTD([Order ID])' />
      </column>
      <column caption='Dynamic Metric' datatype='real' name='[Calculation_2205114958245894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2205114957373445] WHEN &quot;Total Sales&quot; THEN SUM([Amount]) WHEN &quot;Profit&quot; THEN SUM([Profit]) WHEN &quot;Orders&quot; THEN COUNTD([Order ID]) WHEN &quot;Quantity&quot; THEN SUM([Quantity]) WHEN &quot;Profit Margin&quot; THEN SUM([Profit]) / SUM([Amount]) END' />
      </column>
