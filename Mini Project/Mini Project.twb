            <zone h='84166' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99166' x='417' y='15093'>
              <flipboard active-id='5' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Overall, the business generated ₹4,31,502 in sales with a 5.55% profit margin across 500 orders.' captured-sheet='Dashboard 1' id='2' />
                  <story-point caption='Electronics leads in volume, but Top Products shows Electronic Games and Tables actually run at a loss.' captured-sheet='Category Sales' id='3'>
                    <capturedDeltas>
                      <worksheet name='Category Sales'>
                        <filter class='categorical' column='[federated.0dkmaq51gu1jjs16715h90c3baid].[none:Category:nk]'>
                          <groupfilter function='member' level='[none:Category:nk]' member='&quot;Electronics&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Madhya Pradesh and Maharashtra are the top two states by revenue, together contributing a large share of total sales.' captured-sheet='Geo Map' id='4' />
                  <story-point caption='Monthly profit margin swings dramatically — several months dip into negative territory, signalling inconsistent discounting or costs.' captured-sheet='Dynamic Trend' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
